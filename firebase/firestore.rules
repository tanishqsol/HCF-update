rules_version = '2';

// Firestore rules for the HCF website + app (project "hcfprod", database "hcflogins").
// Paste into Firebase console → Firestore → (database: hcflogins) → Security → Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // The accounts allowed to add/remove gallery items. Keep in sync with
    // lib/galleryAdmins.js (website) and src/lib/config.ts (app).
    function isGalleryAdmin() {
      return signedIn() && request.auth.token.email in
        ['admin@hcfofgreaterboston.com', 'tanishqsolanki7@gmail.com'];
    }

    // Shared gallery: any signed-in member can view; only admins can change it.
    // Photos are files in Vercel Blob; videos are YouTube links.
    match /gallery/{itemId} {
      allow read: if signedIn();
      allow create: if isGalleryAdmin()
        && request.resource.data.kind in ['image', 'youtube']
        && request.resource.data.url is string
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000;
      allow update, delete: if isGalleryAdmin();
    }

    // Member profiles written by the website and the app at sign-up / sign-in.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
