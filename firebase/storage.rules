rules_version = '2';

// Cloud Storage rules for the HCF website + app (project "hcfprod").
// Paste into Firebase console → Storage → Rules.

service firebase.storage {
  match /b/{bucket}/o {

    // Gallery photos and videos: members can view, only the admin can upload or delete.
    match /gallery/{allPaths=**} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null
        && request.auth.token.email == 'admin@hcfgreaterboston.com';
      allow create, update: if request.auth != null
        && request.auth.token.email == 'admin@hcfgreaterboston.com'
        && request.resource.size < 500 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|video/.*');
    }
  }
}
